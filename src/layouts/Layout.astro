---
// This is the base layout designed for differen pages

// components
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import MobileDock from "@components/MobileDock.astro";
import CommandPalette from "@components/CommandPalette.astro";
import PixelStrip from "@components/PixelStrip.astro";
import BaseHead from "@components/BaseHead.astro";
import { Agentation } from "agentation";
// import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";

// Types
type Props = {
  pageTabTitle: string;
  categoryTabTitle: string;
  pageTitle?: string;
  showNav: boolean;
  description?: string;
  image?: string;
};

// styles
import "@styles/minimal.css";
import "@styles/custom.css";

// props
const {
  pageTabTitle,
  pageTitle,
  categoryTabTitle,
  showNav,
  description,
  image,
} = Astro.props;

const fullTitle = `${pageTabTitle} • ${categoryTabTitle}`;
const isDev = import.meta.env.DEV;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={fullTitle} description={description} image={image} />

    <!-- Web analytics -->
    <script
      is:inline
      data-goatcounter="https://a-sh.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"></script>

    <!-- Theme -->
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem("theme");
          if (theme === "dark" || theme === "light") {
            document.documentElement.setAttribute("data-theme", theme);
          } else {
            // No override: CSS follows the OS via prefers-color-scheme.
            document.documentElement.removeAttribute("data-theme");
          }
        } catch (e) {}
      })();
    </script>

    <script is:inline>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/sw.js");
      }
    </script>
  </head>
  <body>
    <Header title={pageTitle} showNav={showNav} />
    <PixelStrip />
    <main>
      <slot />
    </main>
    <Footer />
    {showNav && <MobileDock />}
    {showNav && <CommandPalette />}
    {isDev && <Agentation client:only="react" />}
  </body>
</html>
