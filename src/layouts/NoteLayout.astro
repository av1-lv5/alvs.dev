---
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import { getGeneratedOgImage } from "@utils/og-image";

// Components
import BackInHistory from "@components/BackInHistory.astro";

type Props = {
  note: CollectionEntry<"notes">;
};

// props
const { note } = Astro.props;

const ogImage = getGeneratedOgImage("notes", note.id);
---

<Layout
  categoryTabTitle="Note"
  pageTabTitle={note.data.title}
  showNav={true}
  description={note.data.description}
  image={ogImage}
>
  <div class="sub-navigation">
    <BackInHistory />
    <div class="links-container">
      <a href="/" class="nav-like">Home</a>
      <a href="/notes" class="nav-like">Notes</a>
    </div>
  </div>
  <h1>{note.data.title}</h1>
  <div class="note-content">
    <slot />
  </div>
</Layout>

<script>
  document.querySelectorAll(".note-content pre").forEach((pre) => {
    const code = pre.querySelector("code");
    const langClass = Array.from(code?.classList ?? []).find((c) =>
      c.startsWith("language-"),
    );
    const lang = langClass ? langClass.replace("language-", "") : null;

    const wrapper = document.createElement("div");
    wrapper.className = "code-wrapper";
    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);

    if (lang) {
      const label = document.createElement("span");
      label.className = "lang-label";
      label.textContent = lang;
      wrapper.appendChild(label);
    }

    const copyBtn = document.createElement("button");
    copyBtn.className = "copy-btn";
    copyBtn.setAttribute("aria-label", "Copy code");
    copyBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-copy"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-check" style="display:none"><polyline points="20 6 9 17 4 12"/></svg>`;
    wrapper.appendChild(copyBtn);

    copyBtn.addEventListener("click", async () => {
      await navigator.clipboard.writeText(pre.textContent ?? "");
      copyBtn.classList.add("copied");
      const iconCopy = copyBtn.querySelector<HTMLElement>(".icon-copy");
      const iconCheck = copyBtn.querySelector<HTMLElement>(".icon-check");
      if (iconCopy) iconCopy.style.display = "none";
      if (iconCheck) iconCheck.style.display = "block";
      setTimeout(() => {
        copyBtn.classList.remove("copied");
        if (iconCopy) iconCopy.style.display = "";
        if (iconCheck) iconCheck.style.display = "none";
      }, 2000);
    });
  });

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  document
    .querySelectorAll<HTMLDetailsElement>("details.note-disclosure")
    .forEach((details) => {
      const summary = details.querySelector("summary");
      if (!summary) return;

      const content = document.createElement("div");
      content.className = "disclosure-content";
      Array.from(details.children)
        .filter((child) => child !== summary)
        .forEach((child) => content.appendChild(child));
      details.appendChild(content);

      if (prefersReducedMotion) return;

      let animating = false;
      summary.addEventListener("click", (event) => {
        event.preventDefault();
        if (animating) return;

        animating = true;
        details.style.height = `${details.offsetHeight}px`;

        if (details.open) {
          requestAnimationFrame(() => {
            details.style.height = `${summary.offsetHeight}px`;
          });

          const finishClosing = (transitionEvent: TransitionEvent) => {
            if (transitionEvent.propertyName !== "height") return;
            details.open = false;
            details.style.height = "";
            animating = false;
            details.removeEventListener("transitionend", finishClosing);
          };
          details.addEventListener("transitionend", finishClosing);
          return;
        }

        details.open = true;
        requestAnimationFrame(() => {
          details.style.height = `${details.scrollHeight}px`;
        });

        const finishOpening = (transitionEvent: TransitionEvent) => {
          if (transitionEvent.propertyName !== "height") return;
          details.style.height = "";
          animating = false;
          details.removeEventListener("transitionend", finishOpening);
        };
        details.addEventListener("transitionend", finishOpening);
      });
    });
</script>

<style>
  .sub-navigation {
    display: flex;
    justify-content: space-between;
    margin: 1.5rem 0;
  }
  .links-container {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  a.nav-like {
    border-color: var(--accent);
    color: var(--accent);
  }

  .note-content :global(.code-wrapper) {
    position: relative;
    margin: 1.5rem 0;
  }
  .note-content :global(pre) {
    margin: 0;
  }
  .note-content :global(.lang-label) {
    position: absolute;
    top: 0.6rem;
    left: 0.9rem;
    z-index: 1;
    font-size: 0.7rem;
    opacity: 0.35;
    letter-spacing: 0.05em;
    text-transform: lowercase;
    pointer-events: none;
    font-family: var(--mono);
  }
  .note-content :global(.copy-btn) {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 1;
    background: none;
    border: none;
    cursor: pointer;
    color: inherit;
    opacity: 0.3;
    padding: 0.25rem;
    transition: opacity 200ms ease;
    display: flex;
    align-items: center;
  }

  /* Reusable disclosure pattern for long note sections. */
  .note-content :global(details.note-disclosure) {
    margin: 0 0 0.75rem;
    border: 1px solid var(--border-muted);
    border-radius: var(--radius);
    overflow: hidden;
    background: color-mix(in srgb, var(--bg-soft) 32%, transparent);
    transition: height 180ms cubic-bezier(0.4, 0, 0.2, 1);
    will-change: height;
  }

  .note-content :global(h2#workflow-log) {
    margin-top: 3.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-muted);
  }

  .note-content :global(details.note-disclosure > summary) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    padding: 0.55rem 1rem;
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .note-content :global(details.note-disclosure > summary::-webkit-details-marker) {
    display: none;
  }

  .note-content :global(details.note-disclosure > summary::after) {
    content: "+";
    color: var(--text-light);
    font-family: var(--mono);
    font-size: 1.1rem;
    font-weight: 400;
  }

  .note-content :global(details.note-disclosure[open] > summary) {
    border-bottom: 1px solid var(--border-muted);
  }

  .note-content :global(details.note-disclosure[open] > summary::after) {
    content: "−";
  }

  .note-content :global(details.note-disclosure[open] > .disclosure-content) {
    margin-inline: 1rem;
  }

  .note-content :global(
      details.note-disclosure[open] > .disclosure-content > h4:first-of-type
    ) {
    margin-top: 1.25rem;
  }

  .note-content :global(details.note-disclosure[open] > .disclosure-content > h4) {
    font-size: 1rem;
    margin-bottom: 0.75rem;
  }

  .note-content :global(
      details.note-disclosure[open] > .disclosure-content > :last-child
    ) {
    margin-bottom: 1rem;
  }

  .note-content :global(details.note-disclosure + p:last-child) {
    margin-top: 1.5rem;
    color: var(--text-light);
    font-size: 0.9rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .note-content :global(details.note-disclosure > summary:hover) {
      background: var(--bg-soft);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .note-content :global(.copy-btn:hover) {
      opacity: 0.8;
    }
  }
</style>
