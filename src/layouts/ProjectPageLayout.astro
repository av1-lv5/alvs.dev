---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";

// Components
import BackInHistory from "@components/BackInHistory.astro";
import ProjectLinks from "@components/ProjectLinks.astro";
import LikeButton from "@components/LikeButton.astro";

type Props = {
  project: CollectionEntry<"projects">;
};

// props
const { project } = Astro.props;

// related notes, in the order declared on the project; drafts shown in dev only
const relatedSlugs = project.data.relatedNotes ?? [];
const notesById = new Map(
  (
    await getCollection(
      "notes",
      ({ id, data }) =>
        relatedSlugs.includes(id) && (!data.draft || import.meta.env.DEV),
    )
  ).map((note) => [note.id, note]),
);
const relatedNotes = relatedSlugs
  .map((slug) => notesById.get(slug))
  .filter((note): note is CollectionEntry<"notes"> => note !== undefined);
---

<Layout
  categoryTabTitle="Projects"
  pageTabTitle={project.data.title}
  showNav={true}
  description={project.data.description}
>
  <div class="actions-container">
    <BackInHistory href="/projects" label="Projects" />
    <ProjectLinks
      projectLiveAt={project.data.liveAt}
      projectRepoId={project.data.repoId}
    />
  </div>
  <h1>{project.data.title}</h1>
  <div id="project-content">
    <slot />
  </div>
  <LikeButton type="projects" id={project.id} />
  {
    relatedNotes.length > 0 && (
      <aside class="related-notes">
        <p class="related-label">Related notes</p>
        <ul>
          {relatedNotes.map((note) => (
            <li>
              <a href={`/notes/${note.id}`}>{note.data.title}</a>
              {note.data.draft && <span class="draft-tag">draft</span>}
            </li>
          ))}
        </ul>
      </aside>
    )
  }
</Layout>

<style>
  .actions-container {
    display: flex;
    margin: 1.5rem 0;
    justify-content: space-between;
  }
  .actions-container :global(a.nav-like) {
    border-color: var(--accent);
    color: var(--accent);
  }
  #project-content :global(img) {
    height: 250px;
    width: 100%;
    object-fit: cover;
    object-position: center;
  }
  #project-content > :global(:last-child) {
    margin-bottom: 0;
  }
  #project-content + :global(.like) {
    margin-top: 1.75rem;
  }
  @media (max-width: 768px) {
    #project-content :global(img) {
      height: 150px;
    }
  }
  .related-notes {
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border-muted);
  }
  .related-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-light);
    margin: 0 0 1rem;
  }
  .related-notes ul {
    list-style: none;
    padding-left: 0;
    margin-bottom: 0;
  }
  .related-notes li {
    margin: 0 0 0.4rem;
    padding: 0;
  }
  .related-notes a {
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--text-muted);
  }
  @media (hover: hover) and (pointer: fine) {
    .related-notes a:hover {
      color: var(--accent);
    }
  }
  .related-notes .draft-tag {
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-light);
    margin-left: 0.5rem;
  }
</style>
