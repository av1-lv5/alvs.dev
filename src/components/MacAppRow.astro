---
import { Icon } from "astro-icon/components";
import type { MacApp, MacAppPrice } from "@data/macApps";

interface Props {
  app: MacApp;
}

const { app } = Astro.props;

const priceLabel: Record<MacAppPrice, string> = {
  free: "Free",
  "open-source": "Open source",
  freemium: "Free tier",
  "one-time": "One-time",
  subscription: "Subscription",
};

const slugify = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");

const hostFor = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return "";
  }
};

const iconFor = (url: string) => {
  const host = hostFor(url);
  return host ? `https://icons.duckduckgo.com/ip3/${host}.ico` : "";
};

// GitHub's favicon is black-on-transparent, so dark mode loses it. Render the
// vector mark instead; it inherits the text colour in both themes.
const isGitHub = hostFor(app.url) === "github.com";
---

<li id={slugify(app.name)}>
  <a class="app-link" href={app.url} target="_blank" rel="noopener noreferrer">
    <span class="app-icon" aria-hidden="true" data-ink={app.ink}>
      {
        isGitHub ? (
          <Icon name="simple-icons:github" size={20} class="app-glyph" />
        ) : (
          <>
            <span class="app-letter" hidden>
              {app.name.charAt(0)}
            </span>
            <img
              src={app.icon ?? iconFor(app.url)}
              alt=""
              loading="lazy"
              decoding="async"
              width="32"
              height="32"
              referrerpolicy="no-referrer"
              onerror="this.previousElementSibling.hidden = false; this.remove()"
            />
          </>
        )
      }
    </span>

    <span class="app-body">
      <span class="app-title">
        <span class="app-name">{app.name}</span>
        <span class="app-price">{priceLabel[app.price]}</span>
      </span>
      <span class="app-why">{app.why}</span>
    </span>

    <Icon name="lucide:arrow-up-right" size={14} class="app-arrow" />
  </a>
</li>

<style>
  li {
    position: relative;
    margin: 0;
    padding: 0;
    scroll-margin-top: calc(var(--header-height) + 1rem);
  }

  .app-link {
    position: relative;
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 0.65rem 0.6rem;
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .app-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: var(--bg-soft);
    color: var(--text-light);
    font-family: var(--mono);
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  .app-icon img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 4px;
    border: 0;
    border-radius: 0;
    object-fit: contain;
  }

  /* Invert the artwork only, never the tile: a tile background would flip too. */
  :global(:root[data-theme="light"]) .app-icon[data-ink="light"] img {
    filter: invert(1);
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme="dark"])) .app-icon[data-ink="light"] img {
      filter: invert(1);
    }
  }

  .app-glyph {
    color: var(--text-muted);
  }

  .app-body {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .app-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.1rem 0.5rem;
    min-width: 0;
  }

  .app-name {
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.35;
    transition: color 0.15s ease;
  }

  .app-price {
    margin-left: auto;
    padding-left: 0.75rem;
    color: var(--text-light);
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .app-why {
    color: var(--text-muted);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .app-arrow {
    color: var(--text-light);
    transition:
      color 0.15s ease,
      transform 0.15s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .app-link:hover {
      background: var(--bg-soft);
    }

    .app-link:hover .app-name,
    .app-link:hover .app-arrow {
      color: var(--accent);
    }

    .app-link:hover .app-arrow {
      transform: translate(1px, -1px);
    }
  }
</style>
