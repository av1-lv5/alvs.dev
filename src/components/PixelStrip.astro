---
// Decorative pixel-condensation strip shown at the top of mobile pages only
// (where the bottom dock replaces the top navigation).
// Static SVG pattern generated at build time (seeded, deterministic).
// No JS, no animation — theme-adaptive via var(--accent).

const CELL = 8;
const COLS = 64; // 512px tile
const ROWS = 4; // 32px strip
const TILE_W = COLS * CELL;
const TILE_H = ROWS * CELL;

function mulberry32(seed: number) {
  return function () {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

type Cell = { x: number; y: number; o: number };

const rand = mulberry32(11);
const density = [0.72, 0.38, 0.16, 0.06];
const alpha = [0.85, 0.55, 0.3, 0.16];
const cells: Cell[] = [];

for (let y = 0; y < ROWS; y++) {
  for (let x = 0; x < COLS; x++) {
    if (rand() < density[y]) {
      cells.push({ x, y, o: alpha[y] * (0.85 + rand() * 0.3) });
    }
  }
}

// A few longer vertical drips.
for (let i = 0; i < 5; i++) {
  const x = Math.floor(rand() * COLS);
  const len = 2 + Math.floor(rand() * 3);
  for (let y = 0; y < len; y++) {
    cells.push({ x, y, o: 0.85 - y * 0.12 });
  }
}

const rects = cells
  .map(
    (c) =>
      `<rect x="${c.x * CELL}" y="${c.y * CELL}" width="${CELL}" height="${CELL}" fill-opacity="${Math.min(1, c.o).toFixed(2)}"/>`,
  )
  .join("");
---

<div class="pixel-strip" aria-hidden="true">
  <svg
    width="100%"
    height={TILE_H}
    aria-hidden="true"
    shape-rendering="crispEdges"
  >
    <defs>
      <pattern
        id="px-condensation"
        width={TILE_W}
        height={TILE_H}
        patternUnits="userSpaceOnUse"
      >
        <g set:html={rects} />
      </pattern>
    </defs>
    <rect width="100%" height={TILE_H} style="fill: url(#px-condensation)"
    ></rect>
  </svg>
</div>

<style is:global>
  .pixel-strip {
    display: none;
  }

  /* Literal fills (no CSS vars) — var() inside <pattern> content is not
     resolved by WebKit/Safari, which renders the strip transparent. */
  #px-condensation rect {
    fill: hsl(220, 83%, 53%); /* --accent, light */
  }

  [data-theme="dark"] #px-condensation rect {
    fill: hsl(220, 91%, 60%); /* --accent, dark */
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) #px-condensation rect {
      fill: hsl(220, 91%, 60%);
    }
  }

  @media (max-width: 768px) {
    .pixel-strip {
      display: block;
      width: 100%;
      pointer-events: none;
      user-select: none;
    }
  }
</style>
