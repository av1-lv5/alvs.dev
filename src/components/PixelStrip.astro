---
// A small abstract fold in an otherwise quiet horizontal seam.
const pixels = [
  { x: 0, y: 8, opacity: 0.24 },
  { x: 6, y: 4, opacity: 0.46 },
  { x: 12, y: 8, opacity: 0.58 },
  { x: 18, y: 12, opacity: 0.34 },
  { x: 24, y: 8, opacity: 0.22 },
  { x: 30, y: 4, opacity: 0.12 },
];
---

<div class="pixel-strip" aria-hidden="true">
  <svg
    class="pixel-signature"
    width="40"
    height="24"
    viewBox="0 0 40 24"
    fill="currentColor"
    shape-rendering="crispEdges"
    focusable="false"
  >
    <g transform="translate(0 2)">
      {
        pixels.map(({ x, y, opacity }) => (
          <rect x={x} y={y} width="4" height="4" opacity={opacity} />
        ))
      }
    </g>
  </svg>
</div>

<style is:inline>
  .pixel-strip {
    display: none;
  }

  @media (max-width: 768px) {
    .pixel-strip {
      position: relative;
      display: block;
      width: min(var(--max-width), 90%);
      padding-top: calc(16px + env(safe-area-inset-top, 0px));
      margin-bottom: -1rem;
      color: var(--accent);
      pointer-events: none;
      user-select: none;
    }

    .pixel-signature {
      display: block;
    }

    .pixel-strip::after {
      content: "";
      position: absolute;
      top: calc(27px + env(safe-area-inset-top, 0px));
      inset-inline: 48px 0;
      height: 1px;
      background: linear-gradient(to right, currentColor, transparent 85%);
      opacity: 0.12;
    }
  }
</style>
