---
import { Icon } from "astro-icon/components";
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---

<a
  id="back-in-history"
  class="nav-like"
  href={href}
  aria-label={`Back to ${label}`}
>
  <Icon name={"lucide:arrow-left"} size={16} />
</a>

<style>
  #back-in-history {
    cursor: pointer;
    width: fit-content;
    padding: 0.45rem 1rem;
    height: auto;
  }
  a.nav-like {
    border-color: var(--accent);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
