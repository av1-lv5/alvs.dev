---
import { cardName } from "../../../lib/games/navigation";
import { PAIR_COUNT } from "../../../lib/games/rules";

// One cell per card; the columns only decide the shape of the grid.
const cells = PAIR_COUNT * 2;
---

<div
  class="pairs-grid"
  role="group"
  aria-label="Pairs cards. Use the arrow keys to move, then Enter or Space to flip."
>
  {
    Array.from({ length: cells }, (_, cell) => (
      <button
        type="button"
        class="pairs-card game-cell"
        data-pair-card={cell}
        aria-label={`${cardName(cell)}, face down`}
        aria-pressed="false"
        tabindex="-1"
        disabled
      >
        <span class="pairs-face pairs-back" aria-hidden="true" />
        <span
          class="pairs-face pairs-front"
          data-pair-front
          aria-hidden="true"
        />
      </button>
    ))
  }
</div>

<style>
  .pairs-grid {
    display: grid;
    /* Matches PAIR_COLUMNS. */
    grid-template-columns: repeat(4, 1fr);
    gap: var(--game-cell-gap);
  }
  .pairs-card {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    padding: 0;
    cursor: pointer;
    touch-action: manipulation;
  }
  .pairs-card:disabled {
    opacity: 1;
    cursor: default;
  }
  .pairs-face {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition:
      opacity 130ms ease-out,
      transform 130ms ease-out;
  }
  .pairs-back::after {
    content: "";
    width: 24%;
    aspect-ratio: 1;
    border-radius: 1.5px;
    background: color-mix(in srgb, var(--text-light) 42%, transparent);
    transform: rotate(15deg);
  }
  .pairs-front {
    font-size: 1.9rem;
    line-height: 1;
    opacity: 0;
    transform: scale(0.75);
  }
  .pairs-card.is-face-up .pairs-back {
    opacity: 0;
    transform: scale(0.75);
  }
  .pairs-card.is-face-up .pairs-front {
    opacity: 1;
    transform: scale(1);
  }
  .pairs-card.is-matched {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    background: color-mix(in srgb, var(--accent) 7%, var(--game-control-bg));
    cursor: default;
  }
  .pairs-card.is-wrong {
    border-style: dashed;
    border-color: var(--text);
    background: color-mix(in srgb, var(--text) 12%, var(--bg));
  }
  @media (hover: hover) and (pointer: fine) {
    .pairs-card:not(:disabled):not(.is-face-up):hover {
      background: var(--game-cell-hover-bg);
      border-color: var(--game-cell-hover-border);
    }
  }
  @media (max-width: 768px) {
    .pairs-front {
      font-size: 1.6rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pairs-face {
      transition: none;
    }
  }
</style>
