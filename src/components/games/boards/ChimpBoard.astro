---
import { gridCellName } from "../../../lib/games/navigation";
import { CHIMP_CELLS, CHIMP_COLUMNS } from "../../../lib/games/rules";

// The idle board previews the idea without giving away a real layout.
const PREVIEW = new Map<number, number>([
  [2, 1],
  [8, 2],
  [16, 3],
  [21, 4],
]);
---

<div class="chimp-board">
  <p class="chimp-status">
    <span><b data-chimp-progress>0</b> of <b data-chimp-count>4</b> tapped</span
    >
    <span
      ><b data-chimp-strikes>3</b>{" "}<span data-chimp-strike-label
        >strikes</span
      > left</span
    >
  </p>
  <div
    class="chimp-grid"
    data-chimp-grid
    role="group"
    aria-label="Chimp test grid. Use the arrow keys to move, then Enter or Space to choose."
    aria-hidden="true"
  >
    {
      Array.from({ length: CHIMP_CELLS }, (_, cell) => {
        const number = PREVIEW.get(cell);
        return (
          <button
            type="button"
            class:list={["chimp-cell", { "has-number": number !== undefined }]}
            data-chimp-cell={cell}
            aria-label={gridCellName(cell, CHIMP_COLUMNS)}
            tabindex="-1"
            disabled
          >
            <span class="chimp-number" data-chimp-number>
              {number ?? ""}
            </span>
          </button>
        );
      })
    }
  </div>
</div>

<style>
  .chimp-board {
    display: grid;
    gap: 0.6rem;
  }
  .chimp-status {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.15rem 1rem;
    margin: 0;
    font-size: 0.75rem;
    color: var(--text-light);
  }
  .chimp-status b {
    font: 500 0.8125rem var(--mono);
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }
  .chimp-grid {
    display: grid;
    /* Matches CHIMP_COLUMNS. */
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
  }
  .chimp-cell {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    padding: 0;
    border: 1px solid var(--game-control-border);
    border-radius: var(--radius);
    background: var(--game-control-bg);
    color: var(--text);
    cursor: pointer;
    touch-action: manipulation;
    transition:
      border-color 120ms ease-out,
      background-color 100ms ease-out;
  }
  .chimp-cell:disabled {
    opacity: 1;
    cursor: default;
  }
  .chimp-number {
    font: 500 1.05rem var(--mono);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    opacity: 0;
    transform: scale(0.88);
    transition:
      opacity 100ms ease-out,
      transform 100ms ease-out;
  }
  .chimp-cell.has-number .chimp-number {
    opacity: 1;
    transform: scale(1);
  }
  .chimp-grid.is-hidden .chimp-number {
    opacity: 0;
    transform: scale(0.88);
  }
  .chimp-cell.is-wrong {
    border-style: dashed;
    border-color: var(--text);
    background: color-mix(in srgb, var(--text) 12%, var(--bg));
  }
  .chimp-cell.is-expected {
    outline: 2px solid var(--accent);
    outline-offset: -5px;
  }
  .chimp-cell:not(:disabled):focus-visible {
    border-color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .chimp-cell:not(:disabled):hover {
      background: color-mix(in srgb, var(--game-control-bg) 96%, var(--text));
      border-color: color-mix(
        in srgb,
        var(--game-control-border) 60%,
        var(--accent)
      );
    }
  }
  @media (max-width: 768px) {
    .chimp-grid {
      gap: 6px;
    }
    .chimp-number {
      font-size: 0.95rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .chimp-cell,
    .chimp-number {
      transition: none;
    }
  }
</style>
