---
import { Icon } from "astro-icon/components";
import { tileName } from "../../../lib/games/navigation";
---

<div
  class="pattern-grid"
  role="group"
  aria-label="Pattern tiles. Use the arrow keys to move, then Enter or Space to choose."
>
  {
    Array.from({ length: 9 }, (_, index) => (
      <button
        type="button"
        class="pattern-tile game-cell"
        data-tile={index}
        aria-label={tileName(index)}
        tabindex="-1"
        disabled
      >
        <Icon name="lucide:sparkle" size={22} class="tile-spark" />
      </button>
    ))
  }
</div>

<style>
  .pattern-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--game-cell-gap);
  }
  .pattern-tile {
    position: relative;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    color: var(--text-light);
    cursor: pointer;
    touch-action: manipulation;
  }
  .pattern-tile:disabled {
    opacity: 1;
    cursor: default;
  }
  .tile-spark {
    position: absolute;
    display: none;
  }
  .pattern-tile.is-lit {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }
  .pattern-tile.is-lit .tile-spark {
    display: block;
  }
  .pattern-tile.is-wrong {
    border-style: dashed;
    border-color: var(--text);
    background: color-mix(in srgb, var(--text) 12%, var(--bg));
  }
  .pattern-tile.is-expected {
    outline: 2px solid var(--accent);
    outline-offset: -5px;
  }
  @media (hover: hover) and (pointer: fine) {
    .pattern-tile:not(:disabled):not(.is-lit):hover {
      background: var(--game-cell-hover-bg);
      border-color: var(--game-cell-hover-border);
    }
  }
</style>
