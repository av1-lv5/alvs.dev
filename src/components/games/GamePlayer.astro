---
import { Icon } from "astro-icon/components";
import BackInHistory from "@components/BackInHistory.astro";
import { GAMES } from "../../lib/games/registry";
import { GAME_PARTS } from "./game-parts";
import "../../styles/games.css";

interface Props {
  game: (typeof GAMES)[number];
}
const { game } = Astro.props;
const { Board, Settings } = GAME_PARTS[game.id];
const notes: readonly string[] = game.notes;

// Backticked runs become <kbd> chips, e.g. "then press `Enter` to check".
const noteParts = (note: string) =>
  note.split("`").map((text, index) => ({ text, isKey: index % 2 === 1 }));
---

<div class="game-page">
  <div class="sub-navigation">
    <BackInHistory href="/games" label="Games" />
    <div class="links-container">
      <a href="/" class="nav-like">Home</a>
    </div>
  </div>
  <h1>{game.title}</h1>

  <memory-game data-game={game.id} data-phase="ready">
    <div class="game-arena">
      <div class="game-toolbar">
        <dl class="game-stats">
          <div><dt>Level</dt><dd data-level>1</dd></div>
          <div><dt>Best</dt><dd data-best>—</dd></div>
        </dl>
        <div class="toolbar-actions">
          <button
            type="button"
            class="toolbar-button"
            data-restart
            aria-label="Start over from level 1"
            hidden
          >
            <Icon name="lucide:rotate-ccw" size={16} />
            <span>Start over</span>
          </button>
          <button
            type="button"
            class="toolbar-button"
            data-pause-button
            aria-label="Pause"
            hidden
          >
            <Icon name="lucide:pause" size={16} />
            <span class="toolbar-label">Pause</span>
          </button>
          <button
            type="button"
            class="toolbar-button"
            data-sound
            aria-pressed="false"
            aria-label="Sound effects"
            disabled
          >
            <span data-sound-off><Icon name="lucide:volume-x" size={17} /></span
            >
            <span data-sound-on hidden
              ><Icon name="lucide:volume-2" size={17} /></span
            >
            <span class="toolbar-label" data-sound-label>Sound off</span>
          </button>
        </div>
      </div>

      <div
        class="round-heading"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
        <p class="round-title" data-title>Ready when you are.</p>
        <p class="round-detail" id="game-detail" data-detail>
          {game.instruction}
        </p>
      </div>

      <div class="game-board" data-board>
        <Board />
        <div class="pause-cover" data-pause hidden>
          <Icon name="lucide:pause" size={32} /><span
            >No rush. We're still here.</span
          >
        </div>
      </div>

      <div class="game-actions">
        <button
          type="button"
          class="game-button"
          data-action
          aria-describedby="game-detail"
          disabled>Start game <Icon name="lucide:play" size={15} /></button
        >
      </div>

      <div class="game-settings">
        {Settings && <Settings />}
      </div>
    </div>
    <p
      class="visually-hidden"
      data-announcer
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
    </p>
    <noscript
      ><p>
        These games need JavaScript to play. Please enable it, then reload this
        page.
      </p></noscript
    >
  </memory-game>

  <details class="game-rules">
    <summary>
      <Icon name="lucide:chevron-right" size={15} class="rules-chevron" />
      <span>How to play</span>
    </summary>
    <dl class="rules-list">
      <div>
        <dt>Goal</dt>
        <dd>{game.rule}</dd>
      </div>
      {
        notes.length > 0 && (
          <div>
            <dt>Controls</dt>
            <dd>
              {notes.map((note) => (
                <p>
                  {noteParts(note).map(({ text, isKey }) =>
                    isKey ? <kbd>{text}</kbd> : text,
                  )}
                </p>
              ))}
            </dd>
          </div>
        )
      }
      <div>
        <dt>Pausing</dt>
        <dd>
          Leaving the tab or pressing Pause pauses the round; your run is saved,
          so replay it with no penalty.
        </dd>
      </div>
      <div>
        <dt>Best</dt>
        <dd>The highest level you've completed.</dd>
      </div>
    </dl>
  </details>
</div>

<script>
  import "../../scripts/games/memory-game";
</script>

<style>
  .game-page {
    padding-top: 0;
  }
  /* Same sub-navigation as the note and project pages. */
  .sub-navigation {
    display: flex;
    justify-content: space-between;
    margin: 2.5rem 0 0;
  }
  .links-container {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  a.nav-like {
    border-color: var(--accent);
    color: var(--accent);
  }
  h1 {
    /* Size only: the top/bottom rhythm comes from the global heading rule. */
    font-size: clamp(1.6rem, 5vw, 2.25rem);
  }
  memory-game {
    --board-size: 300px;
    display: block;
  }
  .game-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .game-stats {
    display: flex;
    gap: 2rem;
    margin: 0;
  }
  .game-stats div {
    display: flex;
    gap: 0.65rem;
    align-items: baseline;
  }
  .game-stats dt {
    font-size: 0.8125rem;
    font-weight: 400;
    margin: 0;
    color: var(--text-light);
  }
  .game-stats dd {
    font: 500 1rem var(--mono);
    font-variant-numeric: tabular-nums;
    margin: 0;
    color: var(--text);
  }
  .toolbar-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .toolbar-button {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: transparent;
    font: inherit;
    font-size: 0.75rem;
    color: var(--text-muted);
    cursor: pointer;
    touch-action: manipulation;
  }
  .toolbar-button span {
    display: inline-flex;
  }
  .game-arena {
    padding: 1.5rem 1.5rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-soft);
  }
  .game-settings {
    display: flex;
    justify-content: center;
  }
  .round-heading {
    text-align: center;
    min-height: 80px;
    margin-bottom: 0.75rem;
  }
  .round-title {
    color: var(--text);
    font-weight: 600;
    font-size: 1.125rem;
    margin: 0 0 0.35rem;
  }
  .round-detail {
    font-size: 0.8125rem;
    margin: 0;
    overflow-wrap: anywhere;
  }
  .game-board {
    position: relative;
    width: min(100%, var(--board-size));
    margin: 0 auto;
  }
  .game-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: 48px;
    width: min(100%, var(--board-size));
    margin: 1.25rem auto 0;
  }
  .game-actions .game-button {
    width: 100%;
    min-height: 48px;
    transition: background-color 120ms ease-out;
  }
  .game-actions .game-button:active {
    transform: none;
    background: var(--accent-hover);
  }
  .pause-cover {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: var(--bg-soft);
    font-size: 0.8125rem;
    color: var(--text-light);
  }
  .game-rules {
    padding: 1.1rem 0 0;
    margin-top: 1.5rem;
  }
  summary {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    cursor: pointer;
    min-height: 30px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text);
    transition: color 120ms ease-out;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .rules-chevron {
    flex: none;
    transition: transform 160ms ease-out;
  }
  details[open] .rules-chevron {
    transform: rotate(90deg);
  }
  @media (hover: hover) and (pointer: fine) {
    summary:hover {
      color: var(--accent);
    }
  }
  summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }
  /* A label column turns the help text into four short, scannable answers
     instead of four equal paragraphs. */
  .rules-list {
    display: grid;
    gap: 0.7rem;
    margin: 1rem 0 0;
  }
  .rules-list > div {
    display: grid;
    /* Wide enough for "CONTROLS"; any wider and the label drifts away from
       the sentence it belongs to. */
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 0.25rem 1.25rem;
  }
  .rules-list dt {
    margin: 0;
    padding-top: 0.2rem;
    font: 500 0.6875rem var(--mono);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-light);
  }
  .rules-list dd {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    max-width: 56ch;
  }
  .rules-list dd p {
    margin: 0 0 0.45rem;
  }
  .rules-list dd p:last-child {
    margin-bottom: 0;
  }
  /* Same chip language as the ⌘K hints in the command palette. */
  .rules-list kbd {
    display: inline-block;
    min-width: 1.3em;
    padding: 0.05rem 0.35rem;
    margin: 0 0.05em;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg-soft);
    color: var(--text-muted);
    font: 400 0.72rem var(--mono);
    line-height: 1.5;
    text-align: center;
    white-space: nowrap;
  }
  @media (max-width: 560px) {
    .rules-list > div {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
    .rules-list dt {
      padding-top: 0;
    }
  }
  [data-phase="success"] .round-title {
    color: var(--accent);
  }
  /* Wide screens: the board gets its own column and the round sits beside it,
     instead of a small board in a wide empty card. */
  @media (min-width: 769px) {
    .game-arena {
      display: grid;
      grid-template-columns: var(--board-size) minmax(0, 1fr);
      grid-template-rows: auto 1fr auto auto;
      grid-template-areas:
        "board bar"
        "board status"
        "board actions"
        "board pace";
      column-gap: 2.5rem;
      padding: 1.75rem;
    }
    .game-board {
      grid-area: board;
      align-self: start;
      width: 100%;
      margin: 0;
    }
    .game-toolbar {
      grid-area: bar;
      align-items: flex-start;
    }
    .round-heading {
      grid-area: status;
      text-align: left;
      margin-bottom: 0;
    }
    .game-actions {
      grid-area: actions;
      align-items: stretch;
      margin: 0.75rem 0 0;
    }
    .game-settings {
      grid-area: pace;
      justify-content: flex-start;
    }
    .game-stats {
      gap: 2.25rem;
    }
    .game-stats div {
      flex-direction: column;
      gap: 0.1rem;
    }
    .game-stats dd {
      font-size: 1.5rem;
      line-height: 1.2;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .toolbar-button:hover {
      color: var(--text);
      border-color: var(--text-light);
    }
  }
  /* Same breakpoint as the mobile dock: below it the header is gone and the
     dock covers the bottom, so the page fits the visible height instead of
     scrolling. */
  @media (max-width: 768px) {
    .game-page {
      padding-top: 0;
    }
    .game-arena {
      padding: 1rem 1rem 0.75rem;
    }
    .game-toolbar {
      margin-bottom: 0.5rem;
    }
    .game-stats {
      gap: 1.1rem;
    }
    .game-stats div {
      gap: 0.4rem;
    }
    .toolbar-button {
      min-width: 44px;
    }
    /* Pause and Sound shrink to icons; Start over keeps its words. */
    .toolbar-button .toolbar-label {
      display: none;
    }
    .game-actions {
      margin-top: 1rem;
    }
    /* The arena sits above the dock, so the fade meant for content scrolling
       under the dock would only blur the button and checkbox. */
    :global(.dock-fade) {
      display: none !important;
    }
    /* The pattern board fills the height left above the dock instead of
       stepping down through fixed sizes. --game-chrome is everything else
       on screen: sub-navigation, title, arena header and status, button,
       checkbox, dock and a gap above it. */
    memory-game[data-game="pattern"] {
      --game-chrome: calc(33.75rem + env(safe-area-inset-bottom));
      --board-size: clamp(180px, calc(100vh - var(--game-chrome)), 320px);
    }
    @supports (height: 100dvh) {
      memory-game[data-game="pattern"] {
        --board-size: clamp(180px, calc(100dvh - var(--game-chrome)), 320px);
      }
    }
  }
  @media (max-width: 480px) {
    memory-game[data-game="number"],
    memory-game[data-game="odd"],
    memory-game[data-game="chimp"] {
      --board-size: 264px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .game-actions .game-button,
    summary {
      transition: none;
    }
  }
</style>
