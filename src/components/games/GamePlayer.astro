---
import { Icon } from "astro-icon/components";
import BackInHistory from "@components/BackInHistory.astro";
import { GAMES } from "../../lib/games/registry";
import { GAME_PARTS } from "./game-parts";
import "../../styles/games.css";

interface Props {
  game: (typeof GAMES)[number];
}
const { game } = Astro.props;
const { Board, Settings, Tools, stats } = GAME_PARTS[game.id];
const notes: readonly string[] = game.notes;
const isPuzzle = game.kind === "puzzle";
const Player = isPuzzle ? "puzzle-game" : "memory-game";
// Best is a time per difficulty, so the stat says which one it belongs to.
const bestScope = game.kind === "puzzle" ? game.best.label : null;

// Backticked runs become <kbd> chips, e.g. "then press `Enter` to check".
const noteParts = (note: string) =>
  note.split("`").map((text, index) => ({ text, isKey: index % 2 === 1 }));
---

<div class="game-page">
  <div class="sub-navigation">
    <BackInHistory href="/games" label="Games" />
    <div class="links-container">
      <a href="/" class="nav-like">Home</a>
    </div>
  </div>
  <h1>{game.title}</h1>

  <Player class="game-player" data-game={game.id} data-phase="ready">
    <div class="game-arena">
      <div class="game-toolbar">
        <dl class="game-stats">
          {
            stats.map((label, index) => (
              <div>
                <dt>{label}</dt>
                <dd data-game-stat={index}>—</dd>
              </div>
            ))
          }
          {
            isPuzzle ? (
              <div>
                <dt>Time</dt>
                <dd data-time>0:00.0</dd>
              </div>
            ) : (
              <div>
                <dt>Level</dt>
                <dd data-level>1</dd>
              </div>
            )
          }
          <div>
            <dt>
              Best{
                bestScope && (
                  <span class="stat-scope" data-best-scope>
                    {" "}
                    · {bestScope}
                  </span>
                )
              }
            </dt>
            <dd data-best>—</dd>
          </div>
        </dl>
        <div class="toolbar-actions">
          {Tools && <Tools />}
          <button
            type="button"
            class="toolbar-button"
            data-restart
            aria-label="Start over"
            hidden
          >
            <Icon name="lucide:rotate-ccw" size={16} />
            <span class="toolbar-label">Start over</span>
          </button>
          <button
            type="button"
            class="toolbar-button"
            data-pause-button
            aria-label="Pause"
            hidden
          >
            <Icon name="lucide:pause" size={16} />
            <span class="toolbar-label">Pause</span>
          </button>
          <button
            type="button"
            class="toolbar-button"
            data-sound
            aria-pressed="false"
            aria-label="Sound"
            disabled
          >
            <span data-sound-off><Icon name="lucide:volume-x" size={16} /></span
            >
            <span data-sound-on hidden
              ><Icon name="lucide:volume-2" size={16} /></span
            >
            <span class="toolbar-label">Sound</span>
          </button>
        </div>
      </div>

      <div
        class="round-heading"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
        <p class="round-title" data-title>Ready when you are.</p>
        <p class="round-detail" id="game-detail" data-detail>
          {game.instruction}
        </p>
      </div>

      <div class="game-board" data-board>
        <Board />
        <div class="pause-cover" data-pause hidden>
          <Icon name="lucide:pause" size={28} /><span data-pause-text
            >Saved.</span
          >
        </div>
      </div>

      <div class="game-settings">
        {Settings && <Settings />}
      </div>

      <div class="game-actions">
        <button
          type="button"
          class="game-button"
          data-action
          aria-describedby="game-detail"
          disabled
        >
          <span data-action-label>Start</span>
          <Icon name="lucide:play" size={16} />
        </button>
      </div>
    </div>
    <p
      class="visually-hidden"
      data-announcer
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
    </p>
    <noscript
      ><p>
        These games need JavaScript to play. Please enable it, then reload this
        page.
      </p></noscript
    >
  </Player>

  <details class="game-rules">
    <summary>
      <Icon name="lucide:chevron-right" size={16} class="rules-chevron" />
      <span>How to play</span>
    </summary>
    <dl class="rules-list">
      <div>
        <dt>Goal</dt>
        <dd>{game.rule}</dd>
      </div>
      {
        notes.length > 0 && (
          <div>
            <dt>Controls</dt>
            <dd>
              {notes.map((note) => (
                <p>
                  {noteParts(note).map(({ text, isKey }) =>
                    isKey ? <kbd>{text}</kbd> : text,
                  )}
                </p>
              ))}
            </dd>
          </div>
        )
      }
      <div>
        <dt>Pausing</dt>
        <dd>
          {
            isPuzzle
              ? "Pause or leave the tab and the clock stops. Your puzzle is saved."
              : "Pause or leave the tab. Your run is saved and replays with no penalty."
          }
        </dd>
      </div>
      <div>
        <dt>Best</dt>
        <dd>
          {
            isPuzzle
              ? "Fastest solve, per difficulty."
              : "Highest level completed."
          }
        </dd>
      </div>
    </dl>
  </details>
</div>

<script>
  import "../../scripts/games/memory-game";
  import "../../scripts/games/puzzle-game";
</script>

<style>
  .game-page {
    padding-top: 0;
  }
  /* Same sub-navigation as the note and project pages. */
  .sub-navigation {
    display: flex;
    justify-content: space-between;
    margin: 2.5rem 0 0;
  }
  .links-container {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  a.nav-like {
    border-color: var(--accent);
    color: var(--accent);
  }
  h1 {
    /* Size only: the top/bottom rhythm comes from the global heading rule. */
    font-size: clamp(1.6rem, 5vw, 2.25rem);
  }
  .game-player {
    --board-size: 300px;
    display: block;
  }
  .game-player[data-game="minesweeper"] {
    --board-size: 360px;
  }
  .game-player[data-game="shikaku"] {
    --board-size: 360px;
  }
  /* Stats on the left, the icon group on the right. The group reserves the
     width of every tool the game can show, so the row never rewraps (and the
     board never moves) when Pause, Flag or Start over appear. */
  .game-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
    margin-bottom: 0.75rem;
  }
  /* One stat rhythm on every game: a small label over a tabular value. */
  .game-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    margin: 0;
  }
  .game-stats div {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .game-stats dt {
    font-size: 0.75rem;
    font-weight: 400;
    margin: 0;
    color: var(--text-light);
    white-space: nowrap;
  }
  .stat-scope {
    color: var(--text-light);
  }
  .game-stats dd {
    font: 500 1.25rem var(--mono);
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
    margin: 0;
    color: var(--text);
  }
  .toolbar-actions {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: flex-end;
    /* When the row is too narrow for stats and tools together, the group keeps
       the toolbar's right edge on its own line instead of drifting back to the
       left under the first stat. */
    margin-left: auto;
    /* Two tool slots: the most Start over or Pause ever add to Sound. */
    min-width: calc(2 * var(--game-tap) + 0.5rem);
    gap: 0.5rem;
  }
  /* The minefield can show Flag, Pause and Sound together. */
  .game-player[data-game="minesweeper"] .toolbar-actions {
    min-width: calc(3 * var(--game-tap) + 1rem);
  }
  .game-arena {
    padding: 1.5rem 1.5rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-soft);
  }
  /* The settings sit directly above the primary button and match its width:
     the full arena on a phone, the full rail on a wide screen. */
  .game-settings {
    display: flex;
    justify-content: flex-start;
    width: 100%;
    margin: 0.75rem auto 0;
  }
  /* A setting that cannot be changed is noise, but its row keeps its height so
     the button below never moves between phases. */
  .game-player[data-phase="watch"] .game-settings,
  .game-player[data-phase="recall"] .game-settings,
  .game-player[data-phase="playing"] .game-settings,
  .game-player[data-phase="paused"] .game-settings {
    visibility: hidden;
  }
  /* Reserves the title plus two wrapped lines of detail, which is the most any
     phase needs, so the board does not move when the status changes. */
  .round-heading {
    width: 100%;
    text-align: center;
    /* Reserves the title plus two wrapped lines of detail, which is the most
       any phase needs, so the board and the action below never move. */
    min-height: 5rem;
    margin-bottom: 0.75rem;
  }
  .round-title {
    color: var(--text);
    font-weight: 600;
    font-size: 1.125rem;
    margin: 0 0 0.35rem;
  }
  .round-detail {
    font-size: 0.8125rem;
    margin: 0;
    overflow-wrap: anywhere;
  }
  .game-board {
    position: relative;
    width: min(100%, var(--board-size));
    margin: 0 auto;
  }
  .game-actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    min-height: var(--game-action-height);
    /* Full arena width on a phone; full rail width on a wide screen. */
    width: 100%;
    margin: 0.75rem auto 0;
  }
  .game-actions .game-button {
    width: 100%;
    min-height: var(--game-action-height);
    transition: background-color 120ms ease-out;
  }
  .game-actions .game-button:active {
    transform: none;
    background: var(--accent-hover);
  }
  .pause-cover {
    position: absolute;
    inset: 0;
    /* Above board overlays such as Shikaku's rectangles, which are grid items
       with their own z-index. */
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    /* A surface, not a hole: the page fill and one border read as a covered
       board in both themes while staying inside the shared tokens. */
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.8125rem;
    color: var(--text-light);
  }
  .game-rules {
    padding: 1.1rem 0 0;
    margin-top: 1.5rem;
  }
  summary {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    cursor: pointer;
    min-height: 30px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text);
    transition: color 120ms ease-out;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .rules-chevron {
    flex: none;
    transition: transform 160ms ease-out;
  }
  details[open] .rules-chevron {
    transform: rotate(90deg);
  }
  @media (hover: hover) and (pointer: fine) {
    summary:hover {
      color: var(--accent);
    }
  }
  summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }
  /* A label column turns the help text into four short, scannable answers
     instead of four equal paragraphs. */
  .rules-list {
    display: grid;
    gap: 0.7rem;
    margin: 1rem 0 0;
  }
  .rules-list > div {
    display: grid;
    /* Wide enough for "Controls", the longest label; any wider and the label
       drifts away from the sentence it belongs to. */
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0.25rem 1.25rem;
  }
  .rules-list dt {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--text-light);
  }
  .rules-list dd {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    max-width: 56ch;
  }
  .rules-list dd p {
    margin: 0 0 0.45rem;
  }
  .rules-list dd p:last-child {
    margin-bottom: 0;
  }
  /* Same chip language as the ⌘K hints in the command palette. */
  .rules-list kbd {
    display: inline-block;
    min-width: 1.3em;
    padding: 0.05rem 0.35rem;
    margin: 0 0.05em;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg-soft);
    color: var(--text-muted);
    font: 400 0.72rem var(--mono);
    line-height: 1.5;
    text-align: center;
    white-space: nowrap;
  }
  @media (max-width: 560px) {
    .rules-list > div {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
  [data-phase="success"] .round-title,
  [data-phase="solved"] .round-title {
    color: var(--accent);
  }
  /* Wide screens: one top bar for the stats and the icon group, then the board
     and the round side by side. The free row sits between the status and the
     settings, so the action always lands on the bottom and its bottom edge
     lines up with the board's. */
  @media (min-width: 769px) {
    .game-arena {
      display: grid;
      grid-template-columns: var(--board-size) minmax(0, 1fr);
      grid-template-areas:
        "toolbar toolbar"
        "board status"
        "board ."
        "board settings"
        "board actions";
      grid-template-rows: auto auto 1fr auto auto;
      align-content: start;
      align-items: start;
      column-gap: 2.5rem;
      padding: 1.75rem;
    }
    /* A full-width top bar is what lets the stats and three 44px tools share
       one row; the rail alone (310px at 1440) is too narrow for both. */
    .game-toolbar {
      grid-area: toolbar;
      margin-bottom: 1rem;
    }
    .game-board {
      grid-area: board;
      width: 100%;
      margin: 0;
    }
    .round-heading {
      grid-area: status;
      text-align: left;
      margin-bottom: 0;
    }
    .game-settings {
      grid-area: settings;
      width: 100%;
      justify-content: flex-start;
      margin: 0.75rem 0 0;
    }
    .game-actions {
      grid-area: actions;
      align-items: stretch;
      /* The full width of the right panel, bottom-aligned with the board. */
      width: 100%;
      margin: 0.75rem 0 0;
    }
    .game-stats {
      gap: 0.35rem 1.25rem;
    }
    .game-stats dd {
      font-size: 1.5rem;
    }
  }
  /* Same breakpoint as the mobile dock: below it the header is gone and the
     dock covers the bottom, so the page fits the visible height instead of
     scrolling. */
  @media (max-width: 768px) {
    .game-page {
      padding-top: 0;
    }
    .game-arena {
      padding: 1rem 1rem 0.75rem;
    }
    .game-toolbar {
      gap: 0.25rem;
      margin-bottom: 0.75rem;
    }
    .toolbar-actions {
      gap: 0.25rem;
      min-width: calc(2 * var(--game-tap) + 0.25rem);
    }
    .game-player[data-game="minesweeper"] .toolbar-actions {
      min-width: calc(3 * var(--game-tap) + 0.5rem);
    }
    .game-stats {
      gap: 0.3rem 0.75rem;
    }
    .game-stats dd {
      font-size: 0.9375rem;
    }
    /* The minefield's three stats and its three tools are the one pair that
       cannot share a phone row; pin the wrap so a first best cannot change the
       toolbar's height between phases. */
    .game-player[data-game="minesweeper"] .game-stats {
      min-width: 170px;
    }
    .game-actions {
      margin-top: 1rem;
    }
    /* The arena sits above the dock, so the fade meant for content scrolling
       under the dock would only blur the button and checkbox. */
    :global(.dock-fade) {
      display: none !important;
    }
    /* The pattern board fills the height left above the dock instead of
       stepping down through fixed sizes. --game-chrome is everything else
       on screen: sub-navigation, title, arena header and status, button,
       settings, dock and a gap above it. */
    .game-player[data-game="pattern"] {
      /* Includes the toolbar's tool row, which is always present. */
      --game-chrome: calc(34.75rem + env(safe-area-inset-bottom));
      --board-size: clamp(180px, calc(100vh - var(--game-chrome)), 320px);
    }
    @supports (height: 100dvh) {
      .game-player[data-game="pattern"] {
        --board-size: clamp(180px, calc(100dvh - var(--game-chrome)), 320px);
      }
    }
    /* Puzzle boards also fit the height left above the dock. Their chrome is
       taller than the pattern game's by the board's own readout, the settings
       row and the welcome-back toolbar's second row. */
    .game-player[data-game="minesweeper"],
    .game-player[data-game="shikaku"] {
      --game-chrome: calc(38.5rem + env(safe-area-inset-bottom));
      --board-size: clamp(220px, calc(100vh - var(--game-chrome)), 360px);
    }
    @supports (height: 100dvh) {
      .game-player[data-game="minesweeper"],
      .game-player[data-game="shikaku"] {
        --board-size: clamp(220px, calc(100dvh - var(--game-chrome)), 360px);
      }
    }
  }
  @media (max-width: 480px) {
    .game-player[data-game="number"],
    .game-player[data-game="odd"],
    .game-player[data-game="chimp"] {
      --board-size: 264px;
    }
  }
  /* Short phones: tighten everything that is not the board just enough for the
     action and the difficulty row to clear the fixed dock at 320x720. The board
     drops to its 18px-cell floor, so the dense puzzle still scrolls rather than
     shrinking below a usable cell. */
  @media (max-width: 768px) and (max-height: 760px) {
    .sub-navigation {
      margin-top: 1rem;
    }
    h1 {
      margin-top: 0.75rem;
      margin-bottom: 0.75rem;
    }
    .game-arena {
      padding: 0.75rem 1rem 0.5rem;
    }
    .game-toolbar {
      gap: 0.25rem;
      margin-bottom: 0.5rem;
    }
    .round-heading {
      /* Still reserves two lines: the status text never changes the board's
         y even at the shortest height. */
      margin-bottom: 0.5rem;
    }
    .game-actions {
      margin-top: 0.5rem;
    }
    .game-settings {
      margin-top: 0.25rem;
    }
    .game-player[data-game="minesweeper"],
    .game-player[data-game="shikaku"] {
      --board-size: clamp(190px, calc(100vh - var(--game-chrome)), 360px);
    }
    @supports (height: 100dvh) {
      .game-player[data-game="minesweeper"],
      .game-player[data-game="shikaku"] {
        --board-size: clamp(190px, calc(100dvh - var(--game-chrome)), 360px);
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .game-actions .game-button,
    summary {
      transition: none;
    }
  }
</style>
