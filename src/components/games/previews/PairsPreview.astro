  "🧩",
  "",
  "",
  "",
  "",
  "",
  "",
  "🧩",
  "",
  "",
  "🍕",
];
---

<div class="preview-plane preview-grid mini-pairs">
  {
    cells.map((emoji) => (
      <span class:list={["preview-cell", { open: emoji }]}>
        {emoji ? <span class="preview-glyph">{emoji}</span> : null}
      </span>
    ))
  }
</div>

<style>
  .mini-pairs {
    --preview-columns: 4;
    --preview-cell: 22px;
  }
  .mini-pairs .preview-cell:not(.open)::after {
    content: "";
    width: 4px;
    height: 4px;
    border-radius: 1px;
    background: var(--preview-dot);
    transform: rotate(15deg);
  }
  .mini-pairs .open {
    background: var(--preview-accent-bg);
    border-color: var(--preview-accent-line);
  }
</style>
