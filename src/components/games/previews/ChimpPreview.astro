---
/** A four-by-four preview, independent of the game's own board size: the
 *  numbers sit in four different quadrants so the grid reads as scattered. */
const SIZE = 4;
const NUMBERS = new Map<number, number>([
  [2, 1],
  [5, 2],
  [11, 3],
  [12, 4],
]);
---

<div class="preview-plane preview-grid mini-chimp">
  {
    Array.from({ length: SIZE * SIZE }, (_, cell) => (
      <span class:list={["preview-cell", "preview-mono"]}>
        {NUMBERS.get(cell) ?? ""}
      </span>
    ))
  }
</div>

<style>
  .mini-chimp {
    --preview-columns: 4;
    --preview-cell: 22px;
  }
</style>
