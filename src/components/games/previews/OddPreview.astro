---
const cells = 9;
const MARK_PATH = "M7 4.5v15h10";
---

<div class="preview-plane preview-grid mini-odd">
  {
    Array.from({ length: cells }, (_, cell) => (
      <span class:list={["preview-cell", { turned: cell === 4 }]}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d={MARK_PATH}
            fill="none"
            stroke="currentColor"
            stroke-width="2.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>
    ))
  }
</div>

<style>
  .mini-odd {
    --preview-columns: 3;
    --preview-cell: 28px;
  }
  .mini-odd svg {
    width: 56%;
    aspect-ratio: 1;
  }
  .mini-odd .turned svg {
    transform: rotate(42deg);
  }
</style>
