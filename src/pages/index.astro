---
// layout
import PageLayout from "@layouts/PageLayout.astro";
import { Icon } from "astro-icon/components";
import { getGeneratedOgImage } from "@utils/og-image";

const ogImage = getGeneratedOgImage("pages", "home");
---

<PageLayout
  tabTitle="Hello"
  description="Frontend Engineer based in India"
  image={ogImage}
>
  <section>
    <h1>Hello, I'm Avinash 👋🏽</h1>
    <p class="hero-text">
      I'm a Frontend Engineer based in India, who builds for the web.
    </p>

    <p>If you're exploring:</p>

    <ul>
      <li><a href="/projects">See what I've built</a></li>
      <li><a href="/now">What I'm up to right now</a></li>
      <li><a href="/about">A bit about who I am</a></li>
      <li>
        <a href="/hire-me">Work with me</a>, available for freelance or full-time
      </li>
    </ul>

    <p>
      If you'd prefer a birds-eye view of everything on this site, feel free to
      browse the <a href="/sitemap">Sitemap</a>.
    </p>
  </section>

  <section>
    <h2>Building Orbit</h2>
    <p>
      Orbit is a daily budget app focused on one number: your safe-to-spend
      limit for today. By stripping away bank connections and category overhead,
      it provides a clear daily allowance that automatically adjusts to your
      goals and spendings.
    </p>
    <div class="orbit-actions">
      <a href="/projects/orbit">Case study</a>
      <a
        href="https://www.orbitbudget.com"
        target="_blank"
        rel="noopener noreferrer"
        class="orbit-link"
      >
        orbitbudget.com
        <Icon name="lucide:arrow-up-right" size={16} class="ext-arrow" />
      </a>
    </div>
  </section>
</PageLayout>

<style>
  .orbit-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }

  .orbit-link {
    display: inline-flex;
    align-items: center;
  }

  .orbit-link :global(svg) {
    translate: 0 1px;
  }
</style>
