---
// layout
import PageLayout from "@layouts/PageLayout.astro";
import MacAppRow from "@components/MacAppRow.astro";
import Tooltip from "@components/Tooltip.astro";
import { Icon } from "astro-icon/components";
import { socials } from "@constants/index";

// data
import { macList, type MacEntry, type MacSet } from "@data/macApps";
import { getGeneratedOgImage } from "@utils/og-image";

const ogImage = getGeneratedOgImage("pages", "mac");

const isSet = (entry: MacEntry): entry is MacSet => "apps" in entry;
---

<PageLayout
  tabTitle="Mac setup"
  description="Things to install on a Mac, tried and liked enough to recommend."
  image={ogImage}
>
  <section class="hero">
    <h1>Things to install on your Mac</h1>
    <p class="hero-text">
      Software I've tried and liked enough to tell a friend about. Not what's on
      my Mac; that's <a href="/uses/">/uses</a>.
    </p>
  </section>

  <ul class="apps">
    {
      macList.map((entry) =>
        isSet(entry) ? (
          <li id={entry.label.toLowerCase()} class="set">
            <ul class="set-list">
              {entry.apps.map((app) => (
                <MacAppRow app={app} />
              ))}
            </ul>
          </li>
        ) : (
          <MacAppRow app={entry} />
        ),
      )
    }
  </ul>

  <div class="outro">
    <p>
      Have a recommendation of your own? Feel free to{" "}
      <Tooltip text="Click to copy">
        <button
          type="button"
          class="copy-email-inline"
          data-email={socials.email}
          data-success="Now send me yours."
        >
          email me
          <Icon name="lucide:copy" size={12} class="icon-copy" />
          <Icon name="lucide:check" size={12} class="icon-check" />
        </button>
      </Tooltip>
    </p>
    <p class="outro-date">Last updated: November 2026</p>
  </div>
</PageLayout>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".copy-email-inline")!;
  let timeout: ReturnType<typeof setTimeout> | null = null;

  btn.addEventListener("click", async () => {
    const email = btn.dataset.email!;
    const successMsg = btn.dataset.success!;
    const wrapper = btn.closest<HTMLElement>(".tooltip-wrapper")!;
    const tooltip = wrapper.querySelector<HTMLElement>(".tooltip-text")!;

    await navigator.clipboard.writeText(email);

    if (timeout) clearTimeout(timeout);

    btn.classList.add("copied");
    wrapper.classList.add("show-tooltip", "tooltip-success");
    tooltip.textContent = successMsg;

    timeout = setTimeout(() => {
      btn.classList.remove("copied");
      wrapper.classList.remove("show-tooltip", "tooltip-success");
      tooltip.textContent = "Click to copy";
      timeout = null;
    }, 2000);
  });
</script>

<style>
  .hero {
    margin-bottom: 2.5rem;
  }

  .hero-text {
    margin-bottom: 0;
  }

  .apps {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .set {
    position: relative;
    margin: 0.25rem 0 0.9rem;
    padding: 0;
  }

  .set-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Per row, not per set: the rail must follow the icon when a row's text wraps. */
  .set-list > :global(li)::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0.15rem;
    width: 1px;
    background: var(--border);
    pointer-events: none;
    z-index: 1;
  }

  .set-list > :global(li:first-child)::before {
    top: 1.65rem;
  }

  .set-list > :global(li:last-child)::before {
    bottom: auto;
    height: 1.65rem;
  }

  .set-list > :global(li)::after {
    content: "";
    position: absolute;
    top: 1.65rem;
    left: 0.15rem;
    width: 0.45rem;
    height: 1px;
    background: var(--border);
    pointer-events: none;
    z-index: 1;
  }

  .outro {
    margin-top: 2.5rem;
    color: var(--text-light);
    font-size: 0.875rem;
  }

  .outro p {
    margin: 0;
  }

  .outro .outro-date {
    margin-top: 0.4rem;
  }

  .copy-email-inline {
    all: unset;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .icon-copy {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .icon-check {
    display: none;
    color: #10b981;
    flex-shrink: 0;
  }

  .copy-email-inline.copied .icon-copy {
    display: none;
  }

  .copy-email-inline.copied .icon-check {
    display: block;
  }
</style>
