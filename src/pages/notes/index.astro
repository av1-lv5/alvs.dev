---
import { getCollection } from "astro:content";

// layout
import PageLayout from "@layouts/PageLayout.astro";
import EntryList from "@components/EntryList.astro";

// fetching notes to display; drafts are shown in dev only
const allNotes = (
  await getCollection("notes", ({ data }) => {
    return !data.draft || import.meta.env.DEV;
  })
).sort((a, b) => {
  const dateA = a.data.publishedAt ?? "";
  const dateB = b.data.publishedAt ?? "";
  return dateB.localeCompare(dateA);
});
---

<PageLayout
  tabTitle="Notes"
  description="Unfiltered thoughts. Updated as evolves"
>
  <section class="hero">
    <h1>My public notes</h1>
    <p class="hero-text">
      The content in my notes gets often updated to my current opinions. Notes
      may be unfinished, unpolished. I write to record my thoughts, ideas and
      opinions.
    </p>
    <EntryList entries={allNotes} collection="notes" />
  </section>
</PageLayout>
